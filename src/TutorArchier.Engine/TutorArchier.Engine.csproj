<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TutorArchier.Core\TutorArchier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TutorArchier.Tests" />
  </ItemGroup>

  <!-- Release builds carry the pinned ffmpeg zip (publish.ps1 passes its path); dev builds download it instead. -->
  <ItemGroup Condition="'$(FfmpegBundle)' != ''">
    <EmbeddedResource Include="$(FfmpegBundle)" LogicalName="ffmpeg.zip" />
  </ItemGroup>

</Project>
