<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TutorArchier</AssemblyName>
    <RootNamespace>TutorArchier.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The title-bar logo (gradient tile + Archive glyph) at 16–256 px; Explorer, taskbar and Alt+Tab use it. -->
    <ApplicationIcon>Assets\TutorArchier.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TutorArchier.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TutorArchier.Core\TutorArchier.Core.csproj" />
    <ProjectReference Include="..\TutorArchier.Engine\TutorArchier.Engine.csproj" />
    <ProjectReference Include="..\TutorArchier.Data\TutorArchier.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>

</Project>
