<UserControl x:Class="TutorArchier.UI.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TutorArchier.UI.ViewModels"
             xmlns:controls="clr-namespace:TutorArchier.UI.Controls"
             xmlns:conv="clr-namespace:TutorArchier.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OnboardingViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="760">
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

    <!-- One onboarding step: status icon column, then the step's content indented under its title. -->
    <Style x:Key="Step" TargetType="Border">
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Resources>

  <!-- Opaque: the first run is a single focused task, the shell behind it isn't usable yet. -->
  <Grid Background="{DynamicResource Brush.Layer}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Border Width="640"
              Margin="0,32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="36,32"
              CornerRadius="12"
              Style="{StaticResource Panel}">
        <StackPanel>
          <Border Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="12" Background="{DynamicResource Brush.Logo}">
            <ui:SymbolIcon FontSize="26" Filled="True" Foreground="White" Symbol="Archive20" />
          </Border>
          <TextBlock Margin="0,20,0,0" Style="{StaticResource Text.Display}" Text="TutorArchier'e hoş geldin" />
          <TextBlock Margin="0,8,0,16"
                     Style="{StaticResource Text.Muted}"
                     Text="Başlamadan önce ffmpeg'i ve ekran kartını kontrol ediyoruz. Orijinal dosyalarına hiçbir zaman dokunulmaz." />

          <!-- Step 1: ffmpeg -->
          <Border Style="{StaticResource Step}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:StatusIndicator VerticalAlignment="Center" Kind="{Binding FfmpegStatus}" Text="{Binding FfmpegText}" />
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           BorderThickness="0"
                           Command="{Binding ChooseFfmpegFolderCommand}"
                           Content="Değiştir"
                           Visibility="{Binding IsFfmpegMissing, Converter={StaticResource InverseBoolToVisibility}}" />
              </Grid>

              <Border Margin="24,12,0,0"
                      Padding="16"
                      CornerRadius="8"
                      Background="{DynamicResource Brush.Surface2}"
                      Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Body}"
                             Text="TutorArchier videoları ffmpeg ile işler. Senin için indirip kurabiliriz ya da kurulu olduğu klasörü gösterebilirsin." />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource Text.Caption}"
                             Text="Otomatik kurulum: ffmpeg 8.1 (gyan.dev essentials), yaklaşık 105 MB. İndirilen dosya SHA-256 ile doğrulanır." />

                  <StackPanel Margin="0,14,0,0"
                              Orientation="Horizontal"
                              Visibility="{Binding IsInstalling, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:Button Appearance="Primary"
                               Command="{Binding InstallFfmpegCommand}"
                               Content="Otomatik kur"
                               Icon="{ui:SymbolIcon ArrowDownload24}" />
                    <ui:Button Margin="8,0,0,0"
                               Command="{Binding ChooseFfmpegFolderCommand}"
                               Content="Klasörü göster"
                               Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button Margin="8,0,0,0"
                               Appearance="Transparent"
                               BorderThickness="0"
                               Command="{Binding RetryCommand}"
                               Content="Tekrar ara"
                               Icon="{ui:SymbolIcon ArrowClockwise24}" />
                  </StackPanel>

                  <Grid Margin="0,14,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Text.Number}" Text="{Binding InstallText}" />
                      <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100" Value="{Binding InstallProgress}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Command="{Binding CancelInstallCommand}"
                               Content="İptal" />
                  </Grid>

                  <TextBlock Margin="0,12,0,0"
                             Foreground="{DynamicResource Brush.Danger}"
                             Style="{StaticResource Text.Body}"
                             Text="{Binding FfmpegError}"
                             Visibility="{Binding FfmpegError, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Step 2: encoder tests -->
          <Border Style="{StaticResource Step}">
            <StackPanel>
              <controls:StatusIndicator Kind="{Binding HardwareStatus}" Text="{Binding HardwareText}" />
              <ItemsControl Margin="24,12,0,-8" ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CapabilityChip}">
                    <Border Style="{StaticResource Chip}" ToolTip="{Binding ToolTip}">
                      <controls:StatusIndicator Kind="{Binding Kind}" Text="{Binding Text}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Step 3: benchmark -->
          <Border BorderThickness="0" Style="{StaticResource Step}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:StatusIndicator VerticalAlignment="Center" Kind="{Binding BenchmarkStatus}" Text="{Binding BenchmarkText}" />
              <ui:Button Grid.Column="1"
                         Appearance="Transparent"
                         BorderThickness="0"
                         Command="{Binding SkipBenchmarkCommand}"
                         Content="Atla"
                         Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </Border>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="4" VerticalAlignment="Center" Maximum="100" Value="{Binding Progress}" />
            <TextBlock Grid.Column="1"
                       Width="44"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Number}"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="{Binding Progress, StringFormat={}%{0:0}}"
                       TextAlignment="Right" />
          </Grid>

          <Grid Margin="0,24,0,0">
            <ui:Button HorizontalAlignment="Left"
                       Appearance="Transparent"
                       BorderThickness="0"
                       Command="{Binding SkipOnboardingCommand}"
                       Content="ffmpeg olmadan devam et"
                       Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button MinWidth="120"
                       HorizontalAlignment="Right"
                       Appearance="Primary"
                       Command="{Binding FinishCommand}"
                       Content="Başla"
                       Icon="{ui:SymbolIcon ArrowRight24}"
                       IsDefault="True" />
          </Grid>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
