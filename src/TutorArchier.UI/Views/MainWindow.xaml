<ui:FluentWindow x:Class="TutorArchier.UI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:TutorArchier.UI.Views.Pages"
                 xmlns:views="clr-namespace:TutorArchier.UI.Views"
                 xmlns:vm="clr-namespace:TutorArchier.UI.ViewModels"
                 xmlns:conv="clr-namespace:TutorArchier.UI.Converters"
                 xmlns:controls="clr-namespace:TutorArchier.UI.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
                 Title="TutorArchier"
                 Icon="/Assets/TutorArchier.ico"
                 Width="1280"
                 Height="820"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Foreground="{DynamicResource Brush.Text}"
                 FontFamily="{StaticResource Font.Ui}"
                 FontSize="14">
  <ui:FluentWindow.TaskbarItemInfo>
    <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarProgress}" />
  </ui:FluentWindow.TaskbarItemInfo>

  <ui:FluentWindow.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </ui:FluentWindow.Resources>

  <!-- Plan §6.9 -->
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:AnalysisPage}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:MergePage}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:QueuePage}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:SettingsPage}" />
  </ui:FluentWindow.InputBindings>

  <!-- The background lives here, not on the window: WPF-UI repaints Window.Background with its own grey. -->
  <Grid Background="{DynamicResource Brush.Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0">
      <ui:TitleBar.Header>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.Logo}">
            <ui:SymbolIcon FontSize="14" Filled="True" Foreground="White" Symbol="Archive20" />
          </Border>
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="TutorArchier" />
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="1"
                       PaneDisplayMode="Left"
                       OpenPaneLength="224"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       FrameMargin="0"
                       Transition="FadeIn"
                       TransitionDuration="150">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Ana sayfa"
                               Icon="{ui:SymbolIcon Home24}"
                               TargetPageType="{x:Type pages:HomePage}" />
        <ui:NavigationViewItem Content="Analiz"
                               Icon="{ui:SymbolIcon DataHistogram24}"
                               TargetPageType="{x:Type pages:AnalysisPage}"
                               ToolTip="Analiz (Ctrl+1)" />
        <ui:NavigationViewItem Content="Birleştir"
                               Icon="{ui:SymbolIcon VideoClipMultiple24}"
                               TargetPageType="{x:Type pages:MergePage}"
                               ToolTip="Birleştir (Ctrl+2)" />
        <ui:NavigationViewItem Content="Kuyruk"
                               Icon="{ui:SymbolIcon TaskListLtr24}"
                               TargetPageType="{x:Type pages:QueuePage}"
                               ToolTip="Kuyruk (Ctrl+3)">
          <!-- Running and waiting jobs, so work in progress is visible from any page. -->
          <ui:NavigationViewItem.InfoBadge>
            <ui:InfoBadge Severity="Attention"
                          Value="{Binding ActiveJobs}"
                          Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibility}}" />
          </ui:NavigationViewItem.InfoBadge>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="Ayarlar"
                               Icon="{ui:SymbolIcon Settings24}"
                               TargetPageType="{x:Type pages:SettingsPage}"
                               ToolTip="Ayarlar (Ctrl+,)" />
      </ui:NavigationView.FooterMenuItems>
      <!-- ffmpeg is a hard dependency, so its state is always one glance away; click opens Settings. -->
      <ui:NavigationView.PaneFooter>
        <ui:Button Margin="0,4,0,12"
                   Padding="12,8"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left"
                   Appearance="Transparent"
                   BorderThickness="0"
                   Command="{Binding NavigateCommand}"
                   CommandParameter="{x:Type pages:SettingsPage}"
                   ToolTip="ffmpeg ve donanım ayarları">
          <controls:StatusIndicator Kind="{Binding FfmpegStatus}" Text="{Binding FfmpegStatusText}" />
        </ui:Button>
      </ui:NavigationView.PaneFooter>
    </ui:NavigationView>

    <views:OnboardingView Grid.Row="1"
                          DataContext="{Binding Onboarding}"
                          Visibility="{Binding DataContext.IsOnboardingVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</ui:FluentWindow>
