<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colour tokens, dark variant. Keys must match Tokens.Light.xaml exactly.
       Bg = title bar + navigation, Layer = page area, Surface = cards on the page. -->
  <Color x:Key="Color.Bg">#0E1015</Color>
  <Color x:Key="Color.Layer">#13151B</Color>
  <Color x:Key="Color.Surface">#191C23</Color>
  <Color x:Key="Color.SurfaceHover">#1F232B</Color>
  <Color x:Key="Color.Surface2">#232731</Color>
  <Color x:Key="Color.Border">#262A33</Color>
  <Color x:Key="Color.Text">#ECEEF3</Color>
  <Color x:Key="Color.TextMuted">#9AA1AE</Color>
  <Color x:Key="Color.Accent">#6E5BFF</Color>
  <Color x:Key="Color.AccentHover">#7D6CFF</Color>
  <Color x:Key="Color.AccentPressed">#6150E8</Color>
  <!-- Accent used as text/icon colour on dark surfaces, where the fill accent is too dark to read. -->
  <Color x:Key="Color.AccentText">#A99DFF</Color>
  <Color x:Key="Color.Success">#3FB950</Color>
  <Color x:Key="Color.Warning">#D29922</Color>
  <Color x:Key="Color.Danger">#F85149</Color>
  <Color x:Key="Color.Info">#58A6FF</Color>

  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
  <SolidColorBrush x:Key="Brush.Layer" Color="{StaticResource Color.Layer}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

  <!-- Tinted fills for icon tiles, chips and highlighted drop targets. -->
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.Accent}" Opacity="0.16" />
  <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="{StaticResource Color.Success}" Opacity="0.14" />
  <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{StaticResource Color.Danger}" Opacity="0.12" />
  <SolidColorBrush x:Key="Brush.WarningSubtle" Color="{StaticResource Color.Warning}" Opacity="0.12" />

  <LinearGradientBrush x:Key="Brush.Logo" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#8B7BFF" />
    <GradientStop Offset="1" Color="#4F7BFF" />
  </LinearGradientBrush>

  <!-- WPF-UI overrides: its own neutral greys would otherwise sit next to ours. -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Bg}" />
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource Color.Layer}" />
  <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="CardBackground" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="CardBackgroundPressed" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#D9FFFFFF" />
  <!-- Glyphs drawn on an accent fill. WPF-UI picks black for a bright accent; white reads better on ours. -->
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="White" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="White" />
  <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#D9FFFFFF" />
</ResourceDictionary>
