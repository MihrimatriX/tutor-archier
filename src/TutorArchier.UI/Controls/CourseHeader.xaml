<UserControl x:Class="TutorArchier.UI.Controls.CourseHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TutorArchier.UI.Controls"
             xmlns:services="clr-namespace:TutorArchier.UI.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance services:WorkspaceState}"
             d:DesignWidth="900">
  <!-- The selected course at a glance: a cover of four lectures, its name, size and where it lives. -->
  <Border Padding="14" Style="{StaticResource Panel}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid Width="160" Height="90">
        <!-- Placeholder until the scan has picked the cover lectures. -->
        <controls:VideoThumb CornerRadius="8" />
        <ItemsControl ItemsSource="{Binding Cover}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding CoverColumns}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:VideoThumb Margin="1" CornerRadius="5" Video="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.Title}"
                   Text="{Binding CourseName}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding CourseSummary}" />
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource Text.Caption}"
                   Text="{Binding SelectedFolder}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   ToolTip="{Binding SelectedFolder}" />
      </StackPanel>

      <ui:Button Grid.Column="2"
                 VerticalAlignment="Center"
                 Appearance="Transparent"
                 BorderThickness="0"
                 Click="OnOpenInExplorer"
                 Icon="{ui:SymbolIcon FolderOpen24}"
                 ToolTip="Klasörü Gezgin'de aç" />
    </Grid>
  </Border>
</UserControl>
